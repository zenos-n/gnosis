+/* Widget layout transforms are applied only after its render node is collected. */
+void
+gnosis_gtk_snapshot_set_widget (GtkSnapshot *snapshot, GtkWidget *widget)
+{
+  gtk_snapshot_get_current_state (snapshot)->gnosis_widget = widget;
+}
+
+static gboolean
+gnosis_snapshot_transform (GtkWidget *widget, GtkWidget *owner, GskTransform *local,
+                           float *sx, float *sy, float *dx, float *dy)
+{
+  graphene_matrix_t matrix;
+  double xx, yx, xy, yy, x0, y0;
+  if (!owner || !gtk_widget_compute_transform (widget, owner, &matrix) ||
+      !graphene_matrix_to_2d (&matrix, &xx, &yx, &xy, &yy, &x0, &y0) ||
+      xy != 0 || yx != 0 || xx <= 0 || yy <= 0 ||
+      gsk_transform_get_category (local) < GSK_TRANSFORM_CATEGORY_2D_AFFINE)
+    return FALSE;
+  gsk_transform_to_affine (local, sx, sy, dx, dy);
+  *sx *= xx; *sy *= yy; *dx = *dx * xx + x0; *dy = *dy * yy + y0;
+  return *sx > 0 && *sy > 0;
+}
+
+/* Return an interior rectangle contained by all enclosing snapshot clips. */
+gboolean
+gnosis_gtk_browser_surface_safe_rect (GtkSnapshot *snapshot, GtkWidget *widget, graphene_rect_t *rect)
+{
+  GskTransform *local = gtk_snapshot_get_current_state (snapshot)->transform;
+  for (gsize i = gtk_snapshot_states_get_size (&snapshot->state_stack); i > 0; i--)
+    {
+      GtkSnapshotState *state = gtk_snapshot_states_get (&snapshot->state_stack, i - 1);
+      graphene_rect_t bounds;
+      float top = 0, bottom = 0;
+      if (state->collect_func == gtk_snapshot_collect_rounded_clip)
+        {
+          GskRoundedRect *box = &state->data.rounded_clip.bounds;
+          bounds = box->bounds;
+          top = MAX (box->corner[0].height, box->corner[1].height);
+          bottom = MAX (box->corner[2].height, box->corner[3].height);
+        }
+      else if (state->collect_func == gtk_snapshot_collect_clip)
+        bounds = state->data.clip.bounds;
+      else
+        continue;
+      GtkWidget *owner = NULL;
+      for (gsize j = i; j > 0 && !owner; j--)
+        owner = gtk_snapshot_states_get (&snapshot->state_stack, j - 1)->gnosis_widget;
+      float sx, sy, dx, dy;
+      if (!gnosis_snapshot_transform (widget, owner, local, &sx, &sy, &dx, &dy))
+        return FALSE;
+      graphene_rect_t inner;
+      graphene_rect_init (&inner, (bounds.origin.x - dx) / sx,
+                          (bounds.origin.y + top - dy) / sy, bounds.size.width / sx,
+                          MAX (0, bounds.size.height - top - bottom) / sy);
+      if (!graphene_rect_intersection (rect, &inner, rect))
+        return FALSE;
+    }
+  GtkNative *native = gtk_widget_get_native (widget);
+  GdkSurface *surface = native ? gtk_native_get_surface (native) : NULL;
+  float sx, sy, dx, dy;
+  if (!surface || !gnosis_snapshot_transform (widget, GTK_WIDGET (native), local, &sx, &sy, &dx, &dy))
+    return FALSE;
+  double nx, ny;
+  gtk_native_get_surface_transform (native, &nx, &ny);
+  dx += nx; dy += ny;
+  /* A destination must be integral in logical and device pixels. */
+  guint units = MAX (1, (guint) lround (gdk_surface_get_scale (surface) * 120));
+  guint a = 120, b = units;
+  while (b) { guint remainder = a % b; a = b; b = remainder; }
+  float step = 120.f / a;
+  float left = ceilf ((rect->origin.x * sx + dx) / step) * step;
+  float top = ceilf ((rect->origin.y * sy + dy) / step) * step;
+  float right = floorf (((rect->origin.x + rect->size.width) * sx + dx) / step) * step;
+  float bottom = floorf (((rect->origin.y + rect->size.height) * sy + dy) / step) * step;
+  if (right <= left || bottom <= top)
+    return FALSE;
+  graphene_rect_init (rect, (left - dx) / sx, (top - dy) / sy,
+                      (right - left) / sx, (bottom - top) / sy);
+  return TRUE;
+}
