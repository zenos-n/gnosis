+/* Gnosis has one texture per nested wl_surface, rather than one video widget. */
+gboolean
+gnosis_gtk_snapshot_push_browser_surface (GtkSnapshot *snapshot, GdkSurface *surface, gpointer *cached)
+{
+  GdkSubsurface *subsurface = *cached;
+  if (subsurface && gdk_subsurface_get_parent (subsurface) != surface)
+    {
+      gdk_subsurface_detach (subsurface);
+      g_clear_object (&subsurface);
+      *cached = NULL;
+    }
+  if (!subsurface)
+    {
+      subsurface = gdk_surface_create_subsurface (surface);
+      *cached = subsurface;
+    }
+  if (!subsurface)
+    return FALSE;
+  gtk_snapshot_push_subsurface (snapshot, subsurface);
+  return TRUE;
+}
+
+void
+gnosis_gtk_browser_surface_release (gpointer *cached)
+{
+  if (*cached)
+    {
+      gdk_subsurface_detach (*cached);
+      g_object_unref (*cached);
+      *cached = NULL;
+    }
+}
