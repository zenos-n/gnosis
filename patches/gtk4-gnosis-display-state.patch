+/* Preserve negotiated luminance metadata for Gnosis's nested display. */
+void
+gnosis_gdk_wayland_color_get_luminances (GdkWaylandColorSurface *self,
+                                        guint32                values[5])
+{
+  ImageDescription *desc = self ? self->current_desc : NULL;
+  if (!desc && self)
+    {
+      memcpy (values, self->gnosis_luminances, sizeof self->gnosis_luminances);
+      return;
+    }
+  memset (values, 0, 5 * sizeof (guint32));
+  if (!desc || !desc->has_luminances)
+    return;
+  values[0] = desc->min_lum;
+  values[1] = desc->max_lum;
+  values[2] = desc->ref_lum;
+  values[3] = desc->has_target_luminance ? desc->target_min_lum : desc->min_lum;
+  values[4] = desc->has_target_luminance ? desc->target_max_lum : desc->max_lum;
+}
+
+gboolean
+gnosis_gdk_wayland_color_get_target (GdkWaylandColorSurface *self, gint32 primaries[8], guint32 light[2])
+{
+  ImageDescription *desc = self ? self->current_desc : NULL;
+  if (!desc && self)
+    {
+      memcpy (primaries, self->gnosis_primaries, sizeof self->gnosis_primaries);
+      memcpy (light, self->gnosis_light, sizeof self->gnosis_light);
+      return self->gnosis_has_target;
+    }
+  memset (primaries, 0, 8 * sizeof (gint32));
+  light[0] = desc && desc->has_target_max_cll ? desc->target_max_cll : 0;
+  light[1] = desc && desc->has_target_max_fall ? desc->target_max_fall : 0;
+  if (!desc || !desc->has_target_primaries)
+    return FALSE;
+  gint32 values[] = {desc->target_r_x, desc->target_r_y, desc->target_g_x, desc->target_g_y,
+                     desc->target_b_x, desc->target_b_y, desc->target_w_x, desc->target_w_y};
+  memcpy (primaries, values, sizeof values);
+  return TRUE;
+}
