+void wlr_color_manager_v1_set_output_image_description(struct wlr_color_manager_v1 *manager,
+        struct wlr_output *output, const struct wlr_image_description_v1_data *data) {
+    struct wlr_addon *addon = wlr_addon_find(&output->addons, manager, &output_description_impl);
+    struct output_description *desc;
+    if (addon) desc = wl_container_of(addon, desc, addon);
+    else {
+        desc = calloc(1, sizeof(*desc));
+        if (!desc) return;
+        wlr_addon_init(&desc->addon, &output->addons, manager, &output_description_impl);
+    }
+    if (wlr_image_description_v1_data_equal(&desc->data, data)) return;
+    desc->data = *data;
+    struct wlr_color_management_output_v1 *cm_output;
+    wl_list_for_each(cm_output, &manager->outputs, link)
+        if (cm_output->output == output)
+            wp_color_management_output_v1_send_image_description_changed(cm_output->resource);
+}
+
+static bool luminances_equal(const struct wlr_color_luminances *a, const struct wlr_color_luminances *b) {
+    return a->min == b->min && a->max == b->max && a->reference == b->reference;
+}
+bool wlr_image_description_v1_data_equal(const struct wlr_image_description_v1_data *a,
+        const struct wlr_image_description_v1_data *b) {
+    if (a->tf_named != b->tf_named || a->primaries_named != b->primaries_named ||
+        a->has_mastering_display_primaries != b->has_mastering_display_primaries ||
+        a->has_mastering_luminance != b->has_mastering_luminance ||
+        a->has_luminances != b->has_luminances || a->has_target_luminance != b->has_target_luminance ||
+        a->max_cll != b->max_cll || a->max_fall != b->max_fall) return false;
+    if (a->has_mastering_display_primaries) {
+        const struct wlr_color_primaries *x = &a->mastering_display_primaries, *y = &b->mastering_display_primaries;
+        if (x->red.x != y->red.x || x->red.y != y->red.y || x->green.x != y->green.x || x->green.y != y->green.y ||
+            x->blue.x != y->blue.x || x->blue.y != y->blue.y || x->white.x != y->white.x || x->white.y != y->white.y) return false;
+    }
+    if (a->has_mastering_luminance && (a->mastering_luminance.min != b->mastering_luminance.min ||
+        a->mastering_luminance.max != b->mastering_luminance.max)) return false;
+    return (!a->has_luminances || luminances_equal(&a->luminances, &b->luminances)) &&
+           (!a->has_target_luminance || luminances_equal(&a->target_luminance, &b->target_luminance));
+}
