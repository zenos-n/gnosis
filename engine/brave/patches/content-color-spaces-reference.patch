From: Gnosis contributors
Subject: [REFERENCE] Separate SDR/HDR output and commit asynchronous descriptions

Chromium 155.0.8059.40, BSD-3-Clause upstream. Packaged as the exact-binary
native-content-color.inc adapter, without rebuilding Chromium.

--- a/ui/ozone/platform/wayland/host/wayland_wp_image_description.cc
+++ b/ui/ozone/platform/wayland/host/wayland_wp_image_description.cc
@@ -156,6 +156,17 @@
     display_color_spaces.SetOutputFormats(*hdr_output_format,
                                           *hdr_output_format);
   }
+  for (int i = 0; i < 2; ++i) {
+    const bool alpha = i;
+    const auto srgb = gfx::ContentColorUsage::kSRGB;
+    const auto wcg = gfx::ContentColorUsage::kWideColorGamut;
+    display_color_spaces.SetOutputColorSpaceAndFormat(
+        srgb, alpha, gfx::ColorSpace::CreateSRGB(),
+        display_color_spaces.GetOutputFormat(srgb, alpha));
+    display_color_spaces.SetOutputColorSpaceAndFormat(
+        wcg, alpha, gfx::ColorSpace::CreateDisplayP3D65(),
+        display_color_spaces.GetOutputFormat(wcg, alpha));
+  }
   return base::MakeRefCounted<gfx::DisplayColorSpacesRef>(
       std::move(display_color_spaces));
 }
