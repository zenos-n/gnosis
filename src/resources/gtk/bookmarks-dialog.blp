using Gtk 4.0;
using Adw 1;

template $EphyBookmarksDialog: Adw.Bin {
  Adw.ToolbarView toolbar_view {
    bottom-bar-style: raised;

    [top]
    Adw.HeaderBar {
      title-widget: Adw.WindowTitle {
        title: _("Bookmarks");
      };
      show-end-title-buttons: false;

      [start]
      Button edit_button {
        child: Adw.ButtonContent {
          icon-name: "document-edit-symbolic";
          label: _("Edit");
        };

        clicked => $on_edit_button_clicked();
      }

      [start]
      Button done_button {
        label: _("Done");
        clicked => $on_done_button_clicked();
      }

      [end]
      Button close_button {
        icon-name: "view-sidebar-end-symbolic";
        tooltip-text: _("Close");
        clicked => $on_close_button_clicked();
      }

      [end]
      MenuButton options_menu_button {
        icon-name: "view-more-symbolic";
        tooltip-text: _("Options");
        menu-model: options_menu;
      }
    }

    content: Adw.ToastOverlay toast_overlay {
      child: Box {
        orientation: vertical;
        spacing: 12;
        margin-start: 12;
        margin-end: 12;
        margin-top: 12;
        margin-bottom: 12;

        SearchEntry search_entry {
          placeholder-text: _("Search bookmarks");
          search-changed => $on_search_entry_changed();

          EventControllerKey {
            key-pressed => $on_search_entry_key_pressed();
          }
        }

        Stack toplevel_stack {
          hexpand: true;
          vexpand: true;
          transition-duration: 300;

          StackPage {
            name: "default";
            child: ScrolledWindow {
              hscrollbar-policy: never;
              child: ListBox bookmarks_list_box {
                selection-mode: none;
                valign: start;
                styles [ "boxed-list" ]
              };
            };
          }

          StackPage {
            name: "searching_bookmarks";
            child: ScrolledWindow {
              hscrollbar-policy: never;
              child: ListBox searching_bookmarks_list_box {
                selection-mode: none;
                valign: start;
                styles [ "boxed-list" ]
              };
            };
          }

          StackPage {
            name: "tag_detail";
            child: Box {
              orientation: vertical;
              spacing: 12;

              CenterBox {
                start-widget: Button tag_detail_back_button {
                  action-name: "dialog.tag-detail-back";
                  icon-name: "go-previous-symbolic";
                  tooltip-text: _("All Bookmarks");
                  styles [ "flat" ]
                };
                center-widget: Label tag_detail_label {
                  ellipsize: end;
                  max-width-chars: 0;
                  hexpand: true;
                  styles [ "heading" ]
                };
              }

              ScrolledWindow {
                vexpand: true;
                hscrollbar-policy: never;
                child: ListBox tag_detail_list_box {
                  selection-mode: none;
                  valign: start;
                  styles [ "boxed-list" ]
                };
              }
            };
          }

          StackPage {
            name: "empty-state";
            child: Adw.StatusPage {
              icon-name: "ephy-starred-symbolic";
              title: _("No Bookmarks");
              description: _("Bookmarked pages will appear here");
              styles [ "compact" ]
            };
          }
        }

      };
    };
  }
}

menu options_menu {
  section {
    item {
      label: _("I_mport…");
      action: "app.import-bookmarks";
    }

    item {
      label: _("E_xport…");
      action: "app.export-bookmarks";
    }
  }
}
